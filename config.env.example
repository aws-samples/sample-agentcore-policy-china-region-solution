# Copy to config.env and fill in. config.env is git-ignored.
# Values set in the environment override the ones below.

# ---- China region (required) -------------------------------------------------
CN_PROFILE=${CN_PROFILE:-default}            # AWS CLI profile for your aws-cn account
CN_REGION=${CN_REGION:-cn-north-1}           # cn-north-1 or cn-northwest-1

# ---- Identity provider (required) ----------------------------------------------
# Any OAuth 2.0 / OIDC provider that issues JWT access tokens with the
# client_credentials grant. Auth0 is the default; see README "前置条件".
OIDC_DISCOVERY_URL=${OIDC_DISCOVERY_URL:-https://YOUR_TENANT.us.auth0.com/.well-known/openid-configuration}
OIDC_AUDIENCE=${OIDC_AUDIENCE:-https://agentcore-cedar-demo}   # Auth0 API Identifier
OIDC_CLIENT_ID=${OIDC_CLIENT_ID:-YOUR_CLIENT_ID}
OIDC_SCOPE=${OIDC_SCOPE:-invoke:agentcore}   # scope requested and checked by scenario 05
# The client secret is NOT stored here. scripts/deploy.sh asks for it (or reads
# OIDC_CLIENT_SECRET from the environment) and keeps it in AWS Secrets Manager.

# ---- Optional: global-region control group with Policy in AgentCore -----------
ENABLE_GLOBAL=${ENABLE_GLOBAL:-false}
GLOBAL_PROFILE=${GLOBAL_PROFILE:-global}
GLOBAL_REGION=${GLOBAL_REGION:-us-west-2}

# ---- Names (change only to run several copies side by side) -------------------
STACK_PREFIX=${STACK_PREFIX:-cedar-demo}
